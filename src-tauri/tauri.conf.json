{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PiP Anywhere",
  "mainBinaryName": "pip-anywhere",
  "version": "0.1.0",
  "identifier": "com.pipanywhere.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PiP Anywhere",
        "width": 480,
        "height": 640,
        "minWidth": 380,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "dmg"],
    "category": "Utility",
    "shortDescription": "Picture-in-Picture for any window",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
