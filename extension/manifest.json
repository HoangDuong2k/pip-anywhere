{
  "manifest_version": 3,
  "name": "PiP Anywhere",
  "version": "0.3.0",
  "description": "Keep a browser window always on top of other apps and make it see-through.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "PiP Anywhere",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "commands": {
    "toggle-on-top": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Keep this window on top / release it"
    },
    "opacity-down": {
      "suggested_key": { "default": "Alt+Shift+Down" },
      "description": "Make this window more transparent"
    },
    "opacity-up": {
      "suggested_key": { "default": "Alt+Shift+Up" },
      "description": "Make this window more opaque"
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
